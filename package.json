{
  "name": "ego-runtime",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && npm run build:hermes-decision",
    "build:hermes-decision": "esbuild scripts/hermes-decision-adapter.ts --bundle --platform=node --format=cjs --packages=bundle --sourcemap --outfile=dist/hermes-decision-adapter.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node scripts/demo.js",
    "smoke:model": "node --import tsx scripts/model-smoke.ts",
    "smoke:transcription": "node --import tsx scripts/transcription-smoke.ts",
    "smoke:speech": "node --import tsx scripts/speech-smoke.ts",
    "nigma:hermes-decision": "node --import tsx scripts/hermes-decision-adapter.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@google-cloud/tasks": "^7.0.0",
    "@google/adk": "^1.6.0",
    "@google/genai": "^2.16.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.3.0"
  }
}
