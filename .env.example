RUNTIME_BACKEND=local
LOCAL_INPUT_ROOT=.
LOCAL_DATA_DIR=.ego-runtime
MODEL_PROVIDER=gemini-adk
EGO_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
INTERNAL_RUNTIME_TOKEN=local-dev-token
MAX_ARTIFACT_BYTES=20971520
MAX_CONTEXT_CHARS=250000
MAX_TOTAL_CONTEXT_CHARS=500000
JOB_LEASE_MS=900000
CORS_ORIGINS=http://localhost:3000
PORT=3000
HOST=127.0.0.1
SHUTDOWN_GRACE_MS=30000
MAX_AUDIO_BYTES=10485760
TRANSCRIPTION_TIMEOUT_MS=120000
TRANSCRIPTION_PROVIDER=gemini
EGO_TRANSCRIPTION_MODEL=gemini-3.5-flash

# Cloud adapter (only required when RUNTIME_BACKEND=cloud)
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
ALLOWED_INPUT_BUCKETS=
OUTPUT_BUCKET=
TASKS_QUEUE_PATH=
WORKER_URL=
TASKS_SERVICE_ACCOUNT=
